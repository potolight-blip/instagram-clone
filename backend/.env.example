PROJECT_NAME="Instagram Clone"
SECRET_KEY="instagram-clone-super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120
# local 이면 SQLite. production 이면 아래 주소는 PostgreSQL 이어야 한다.
ENV=local
DATABASE_URL=sqlite:///./instagram.db
# ENV=production
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/instagram
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
